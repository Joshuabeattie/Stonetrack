# Copy this file to .env for local development outside Replit.
# On Replit you don't need a .env file: DATABASE_URL is provided automatically,
# and other values go in the Secrets tool.

# Required. Replit sets this for you.
DATABASE_URL=postgres://postgres@localhost:5432/stonetrack

# Optional. Defaults shown.
# API_PORT=3001                       # development API port (Vite proxies /api to it)
# PORT=5000                           # production port
# WEBHOOK_SECRET=dev-webhook-secret   # REQUIRED in production; signs incoming order webhooks
# DEMO_MODE=true                      # show demo logins, seed an empty database, allow "reset demo"
# FACTORY_TIMEZONE=Australia/Melbourne
# DATABASE_SSL=                       # disable | require | verify (default: off in dev, on in production)
# LOG_LEVEL=info                      # debug | info | warn | error
# DEPLOY_TARGET=node                  # node | cloudflare (the staging Worker sets this in wrangler.jsonc)
