{
  // Type-checking for the server, shared code, tests and scripts.
  // The browser code has its own config in client/tsconfig.json.
  // Nothing is emitted by tsc: tsx runs the code in development and esbuild bundles it for production.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["server", "shared", "tests", "scripts", "vite.config.ts", "vitest.config.ts"]
}
